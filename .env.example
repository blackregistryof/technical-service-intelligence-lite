# Copy to .env.local (local development) or set as Railway service variables.
# Never commit real values. All variables below are required unless noted.

# PostgreSQL connection string (Railway PostgreSQL). Required when DATA_SOURCE=postgres;
# without it data pages fail closed. Not needed for the synthetic data source.
DATABASE_URL=

# Data source for the views: "postgres" or (development/test only) "synthetic".
# Development: optional, defaults to the TEMPORARY read-only in-memory synthetic dataset.
# Production (npm start, Railway): must be "postgres"; synthetic, empty and unknown
# values are rejected and data pages fail closed. With "postgres", a missing
# DATABASE_URL or an unreachable database also fails closed (no synthetic fallback).
DATA_SOURCE=

# Shared application access password. No default exists; login is disabled if unset.
APP_ACCESS_PASSWORD=

# Secret used to sign session cookies: a random string of at least 32 characters.
# Changing it (or APP_ACCESS_PASSWORD) signs out all users.
SESSION_SECRET=
