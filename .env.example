# Copy to .env.local (local development) or set as Railway service variables.
# Never commit real values. All variables below are required unless noted.

# PostgreSQL connection string (Railway PostgreSQL). Not needed until the database stage.
DATABASE_URL=

# Data source for the views. Only "synthetic" exists in V0.1 Stage 4: a TEMPORARY,
# read-only, in-memory synthetic dataset. Optional in development (defaults to
# synthetic); in production it must be set explicitly, otherwise data pages fail
# closed. Replace with the PostgreSQL adapter before the production deployment.
DATA_SOURCE=

# Shared application access password. No default exists; login is disabled if unset.
APP_ACCESS_PASSWORD=

# Secret used to sign session cookies: a random string of at least 32 characters.
# Changing it (or APP_ACCESS_PASSWORD) signs out all users.
SESSION_SECRET=
